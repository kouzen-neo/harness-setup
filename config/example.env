# Owner values for the rule templates. Copy this file to a PRIVATE place, fill it in, and pass it with --env.
# Never commit real values to the public agent-setup repo. Only KEY=value lines are read; nothing is executed.
OWNER_LANGUAGE=English
SHELL_NAME=bash
DOMAIN=example.com
DNS_PROVIDER=Cloudflare
VERCEL_TEAM=my-team
VAULT_PATH=~/Documents/Notes
VAULT_BACKUP_REPO=my-user/notes-vault
